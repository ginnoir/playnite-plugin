<sdk:PluginUserControl x:Class="RomM.SaveSync.GameSyncStatusControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sdk="clr-namespace:Playnite.SDK.Controls;assembly=Playnite.SDK"
    Background="Transparent"
    TextElement.Foreground="{DynamicResource TextBrush}">

    <sdk:PluginUserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </sdk:PluginUserControl.Resources>

    <DockPanel Margin="8">

        <!-- Game picker + refresh -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <Button DockPanel.Dock="Right"
                    Content="↻"
                    ToolTip="Refresh"
                    MinWidth="28"
                    Margin="8,0,0,0"
                    Style="{DynamicResource ButtonStyle}"
                    Command="{Binding RefreshCommand}" />
            <ComboBox ItemsSource="{Binding AvailableGames}"
                      SelectedItem="{Binding SelectedGame, Mode=TwoWay}"
                      DisplayMemberPath="Name"
                      IsEditable="False" />
        </DockPanel>

        <ProgressBar DockPanel.Dock="Top"
                     IsIndeterminate="True"
                     Height="4"
                     Margin="0,0,0,8"
                     Foreground="{DynamicResource ProgressBarForegroundBrush}"
                     Background="{DynamicResource ProgressBarBackgroundBrush}"
                     Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />

        <TextBlock DockPanel.Dock="Top"
                   Text="{Binding StatusNote}"
                   TextWrapping="Wrap"
                   Opacity="0.7"
                   Margin="0,0,0,8"
                   Foreground="{DynamicResource SecondaryTextBrush}"
                   Visibility="{Binding HasStatusNote, Converter={StaticResource BoolToVis}}" />

        <StackPanel DockPanel.Dock="Top"
                    Margin="0,0,0,8"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding ErrorText}"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextBrush}" />
            <Button Content="Retry"
                    Margin="0,4,0,0"
                    HorizontalAlignment="Left"
                    Style="{DynamicResource ButtonStyle}"
                    Command="{Binding RefreshCommand}" />
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Visibility="{Binding ShowContent, Converter={StaticResource BoolToVis}}">
            <StackPanel>

                <StackPanel Visibility="{Binding ShowSavesSection, Converter={StaticResource BoolToVis}}"
                            Margin="0,0,0,12">
                    <TextBlock Text="Battery Saves"
                               FontWeight="SemiBold"
                               Margin="0,0,0,4"
                               Foreground="{DynamicResource TextBrush}" />
                    <ItemsControl ItemsSource="{Binding SaveItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderThickness="0,0,0,1"
                                        BorderBrush="{DynamicResource NormalBorderBrush}"
                                        Padding="0,5">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right"
                                                   Text="{Binding StatusText}"
                                                   FontSize="11"
                                                   VerticalAlignment="Center"
                                                   Margin="8,0,0,0"
                                                   Foreground="{DynamicResource TextBrush}" />
                                        <StackPanel>
                                            <TextBlock Text="{Binding Label}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextBrush}" />
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <TextBlock Text="Local  " FontSize="11"
                                                           Foreground="{DynamicResource SecondaryTextBrush}" />
                                                <TextBlock Text="{Binding LocalTime}" FontSize="11"
                                                           Foreground="{DynamicResource SecondaryTextBrush}" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Server " FontSize="11"
                                                           Foreground="{DynamicResource SecondaryTextBrush}" />
                                                <TextBlock Text="{Binding ServerTime}" FontSize="11"
                                                           Foreground="{DynamicResource SecondaryTextBrush}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel Visibility="{Binding ShowStatesSection, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Save States"
                               FontWeight="SemiBold"
                               Margin="0,0,0,4"
                               Foreground="{DynamicResource TextBrush}" />
                    <ItemsControl ItemsSource="{Binding StateItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderThickness="0,0,0,1"
                                        BorderBrush="{DynamicResource NormalBorderBrush}"
                                        Padding="0,5">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right"
                                                   Text="{Binding StatusText}"
                                                   FontSize="11"
                                                   VerticalAlignment="Center"
                                                   Margin="8,0,0,0"
                                                   Foreground="{DynamicResource TextBrush}" />
                                        <StackPanel>
                                            <TextBlock Text="{Binding Label}"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource TextBrush}" />
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <TextBlock Text="Local  " FontSize="11"
                                                           Foreground="{DynamicResource SecondaryTextBrush}" />
                                                <TextBlock Text="{Binding LocalTime}" FontSize="11"
                                                           Foreground="{DynamicResource SecondaryTextBrush}" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Server " FontSize="11"
                                                           Foreground="{DynamicResource SecondaryTextBrush}" />
                                                <TextBlock Text="{Binding ServerTime}" FontSize="11"
                                                           Foreground="{DynamicResource SecondaryTextBrush}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

    </DockPanel>
</sdk:PluginUserControl>
